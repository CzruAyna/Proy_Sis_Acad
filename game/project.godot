config_version=5

[application]

config/name="SIS-INF"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/CAMPUS EN JUEGO"
config/icon="res://assets/branding/sis_inf_logo.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/size/mode=3
window/size/borderless=false
window/size/resizable=true
window/size/minimum_size=Vector2i(900, 640)
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.062745, 0.070588, 0.086275, 1)
